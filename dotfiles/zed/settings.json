// Zed settings — mirrors nvim habits (see dotfiles/nvim/init.lua)
//
// Docs: https://zed.dev/docs/configuring-zed
// See all defaults: command palette -> "zed: open default settings"
// This file hot-reloads on save, no restart needed.
{
    ////////// EXTENSIONS
    // Installed automatically on startup (like vim.pack.add)
    "agent_servers": {
        "claude-acp": {
            "type": "registry",
        },
    },
    "auto_install_extensions": {
        "vesper": true, // same theme as nvim/noctalia
        "nix": true, // nix language support, uses nixd from PATH
    },

    ////////// UI
    "theme": {
        "mode": "system",
        "light": "Ayu Light",
        "dark": "Vesper",
    },
    "buffer_font_family": "IosevkaTerm Nerd Font",
    "buffer_font_size": 24.0,
    "ui_font_size": 26,
    "relative_line_numbers": "enabled",
    "vertical_scroll_margin": 5, // scrolloff
    "cursor_blink": false,
    "wrap_guides": [],

    ////////// VIM
    "vim_mode": true,
    "vim": {
        // Keep yank/put off the system clipboard like stock vim;
        // space-y / space-p go through the clipboard (see keymap.json)
        "use_system_clipboard": "never",
        "use_smartcase_find": true, // smartcase for f/t motions
    },

    ////////// EDITING
    "tab_size": 4,
    "format_on_save": "on", // conform.nvim behavior
    "use_smartcase_search": true, // ignorecase + smartcase
    "inlay_hints": {
        "enabled": false, // toggle per-buffer with space-t-h (keymap.json)
    },

    ////////// LANGUAGES
    "languages": {
        "Python": {
            "language_servers": ["pyright", "ruff"], // same as nvim LSP setup
        },
        "Nix": {
            "language_servers": ["nixd", "!nil"],
            "formatter": {
                "external": {
                    "command": "alejandra",
                    "arguments": ["--quiet", "--"],
                },
            },
        },
    },

    ////////// TERMINAL (ctrl-` to toggle, like toggleterm)
    "terminal": {
        "dock": "bottom",
    },

    ////////// PANELS
    "project_panel": {
        "dock": "left",
    },
    "outline_panel": {
        "dock": "left",
    },
    "collaboration_panel": {
        "dock": "left",
    },
    "git_panel": {
        "dock": "left",
    },
    "agent": {
        "dock": "right",
        "favorite_models": [],
        "model_parameters": [],
    },

    ////////// MISC
    "cli_default_open_behavior": "new_window",
    "when_closing_with_no_tabs": "keep_window_open",
    "auto_update": false, // nix manages the package, zed can't write to /nix/store
    "telemetry": {
        "diagnostics": false,
        "metrics": false,
    },
}
